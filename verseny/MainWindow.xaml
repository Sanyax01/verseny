<Window x:Class="verseny.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:verseny"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="start" Content="Start" Width="90" Height="45" Grid.Row="1" Background="BurlyWood" Click="start_Click"/>
        <Canvas x:Name="palya" Background="White" Grid.Row="3">
            <Button x:Name="auto" Content="Suzuki" Width="90" Height="45" Background="Magenta" 
                    Canvas.Left="20" Canvas.Top="50" Click="auto_Click" />
            <Button x:Name="auto1" Content="Subaru" Width="90" Height="45" Background="Blue" Foreground="White"
        Canvas.Left="20" Canvas.Top="100" Click="auto_Click" />
            <Button x:Name="auto2" Content="Opel" Width="90" Height="45" Background="Black" Foreground="White"
        Canvas.Left="20" Canvas.Top="150" Click="auto_Click" />
            <Button x:Name="auto3" Content="Audi" Width="90" Height="45" Background="Red" Foreground="White"
Canvas.Left="20" Canvas.Top="200" Click="auto_Click" />
            <Button x:Name="auto4" Content="Toyota" Width="90" Height="45" Background="DarkOrchid"  Foreground="White"
Canvas.Left="20" Canvas.Top="250" />
            <TextBlock x:Name="Celvonal" Width="20" Height="330" Canvas.Right="20">
                <TextBlock.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="White" Offset="0.2"/>
                        <GradientStop Color="#FE000000" Offset="0.2"/>
                        <GradientStop Color="#FE000000" Offset="0.103"/>
                        <GradientStop Color="#FED0D0D0" Offset="0.1"/>
                        <GradientStop Color="#FE000000" Offset="0.1"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.4"/>
                        <GradientStop Color="#FE000000" Offset="0.3"/>
                        <GradientStop Color="#FE000000" Offset="0.4"/>
                        <GradientStop Color="#FEEFEFEF" Offset="0.29"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#FE000000" Offset="0.5"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.6"/>
                        <GradientStop Color="#FE000000" Offset="0.6"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.7"/>
                        <GradientStop Color="#FE000000" Offset="0.7"/>
                        <GradientStop Color="#FE000000" Offset="0.801"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.8"/>
                        <GradientStop Color="#FE000000" Offset="0.901"/>
                        <GradientStop Color="#FEFFFFFF" Offset="0.9"/>
                        <GradientStop Color="#FEFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Background>
            </TextBlock>
        </Canvas>
        
    </Grid>
</Window>
